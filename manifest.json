{
  "manifest_version": 3,
  "name": "ChatMeter — ChatGPT usage tracker",
  "version": "0.2.0",
  "description": "Local estimate of observed ChatGPT prompts, not official quota tracking.",
  "action": {
    "default_title": "Open ChatMeter",
    "default_popup": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
