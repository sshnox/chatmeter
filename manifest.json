{
  "manifest_version": 3,
  "name": "ChatMeter — ChatGPT usage tracker",
  "version": "0.1.0",
  "description": "A local-first usage dashboard for ChatGPT messages, limits, reset timing, and activity.",
  "action": {
    "default_title": "Open ChatMeter",
    "default_popup": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
